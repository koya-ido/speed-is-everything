generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

enum DeviceType {
  PC
  MOBILE
}

enum BattleRoomStatus {
  ACTIVE
  ENDED
}

enum BattleParticipantRole {
  PLAYER_1
  PLAYER_2
  SPECTATOR
}

model User {
  id           String    @id // Supabase Auth の UID
  name         String?   @db.VarChar(15)
  image        String?
  country      String?   @db.VarChar(50)
  isProfileSet Boolean   @default(false)
  playCount        Int          @default(0)
  selectedTitle    String?
  foulCount        Int          @default(0)
  highestPcRank    Int?
  highestMobileRank Int?
  battlePlayCount  Int          @default(0)
  battleWinCount   Int          @default(0)
  battleLoseCount  Int          @default(0)
  battleDrawCount  Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  rankings         Ranking[]
  gamePlays        GamePlay[]
  titles           UserTitle[]
}

model UserTitle {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  titleId    String
  unlockedAt DateTime @default(now())

  @@unique([userId, titleId])
  @@index([userId])
}

model Ranking {
  id            String     @id @default(uuid())
  userId        String
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  deviceType    DeviceType
  clearCount    Int
  remainingTime Float
  averageTime   Float
  medianTime    Float
  rawReactions  Json
  isVerified    Boolean    @default(true)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@unique([userId, deviceType])
  @@index([deviceType, clearCount(sort: Desc), remainingTime(sort: Desc)])
}

model GamePlay {
  id         String      @id @default(uuid())
  userId     String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  deviceType DeviceType?
  createdAt  DateTime    @default(now())

  @@index([createdAt])
  @@index([userId])
}

model BattleRoom {
  id             String            @id @default(cuid())
  code           String            @unique @db.VarChar(7)
  ownerSessionId String
  status         BattleRoomStatus  @default(ACTIVE)
  createdAt      DateTime          @default(now())
  endedAt        DateTime?
  expiresAt      DateTime
  lastActivityAt DateTime          @default(now())
  stateRevision  Int               @default(0)
  stateSnapshot  Json?
  snapshotWriterSessionId String?
  snapshotWriterSequence Int      @default(0)
  participants   BattleParticipant[]

  @@index([status, expiresAt])
}

model BattleParticipant {
  sessionId  String                 @id @default(uuid())
  roomId     String
  room       BattleRoom             @relation(fields: [roomId], references: [id], onDelete: Cascade)
  userId     String?
  userName   String                 @db.VarChar(15)
  role       BattleParticipantRole
  joinOrder  Int
  isOwner    Boolean                @default(false)
  isGameHost Boolean                @default(false)
  tokenHash  String
  lastSeenAt DateTime               @default(now())

  @@unique([roomId, joinOrder])
  @@index([roomId, role, joinOrder])
  @@index([roomId, lastSeenAt])
}